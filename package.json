{
  "name": "decamark",
  "version": "0.1.0",
  "private": true,
  "description": "Product commands for the DECA Mark web, mobile, API, and spatial database",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "contracts:generate": "make -C backend openapi && pnpm --dir web api:types && pnpm --dir mobile api:types",
    "dev": "pnpm web:dev",
    "build": "pnpm web:build",
    "start": "pnpm --dir web start",
    "lint": "pnpm --dir web lint",
    "lint:fix": "pnpm --dir web lint:fix",
    "format": "pnpm --dir web format",
    "format:check": "pnpm --dir web format:check",
    "typecheck": "pnpm --dir web typecheck",
    "setup:apps": "pnpm --dir web install --frozen-lockfile && pnpm --dir mobile install --frozen-lockfile",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:check": "pnpm --dir web check",
    "mobile:dev": "pnpm --dir mobile start",
    "mobile:simulator": "pnpm --dir mobile start:simulator",
    "mobile:ios": "pnpm --dir mobile ios",
    "mobile:android": "pnpm --dir mobile android",
    "mobile:check": "pnpm --dir mobile typecheck && pnpm --dir mobile lint",
    "mobile:test": "pnpm --dir mobile test",
    "backend:setup": "uv sync --project backend --frozen",
    "backend:check": "make backend-check",
    "backend:test": "make backend-test",
    "db:up": "pnpm db:start",
    "db:start": "sh database/local-supabase.sh start",
    "db:stop": "sh database/local-supabase.sh stop",
    "db:reset": "sh database/local-supabase.sh reset",
    "db:test": "make db-test",
    "api:hosted:up": "make api-hosted-up",
    "api:hosted:stop": "make api-hosted-stop",
    "check": "pnpm web:check && pnpm mobile:check && pnpm backend:check",
    "test": "pnpm mobile:test && pnpm backend:test && pnpm db:test",
    "help": "make help",
    "plan:check": "node docs/plan/check-plan.mjs",
    "forms:parity": "node scripts/check-form-engine-parity.mjs",
    "tokens": "node scripts/contour-tokens.mjs && pnpm emails:generate",
    "tokens:check": "node scripts/contour-tokens.mjs --check && pnpm emails:check",
    "emails:generate": "make -C backend email-templates",
    "emails:check": "make -C backend email-templates-check",
    "screenshots:web": "sh scripts/screenshots-web.sh",
    "screenshots:mobile": "node scripts/screenshots-mobile.mjs"
  }
}
