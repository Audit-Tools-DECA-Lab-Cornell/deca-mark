{
  "synthetic": true,
  "scenarios": [
    {
      "id": "create_and_retry",
      "given": {
        "current": "20000000-0000-4000-8000-000000000001",
        "role": "manager"
      },
      "steps": [
        {
          "action": "create",
          "request_id": "create-1",
          "base": "20000000-0000-4000-8000-000000000001",
          "expected": {
            "status": 201,
            "draft": "d1",
            "revision": 1
          }
        },
        {
          "action": "create",
          "request_id": "create-1",
          "base": "20000000-0000-4000-8000-000000000001",
          "expected": {
            "status": 200,
            "draft": "d1",
            "revision": 1
          }
        }
      ]
    },
    {
      "id": "two_saves",
      "given": {
        "draft": "d1",
        "revision": 1
      },
      "steps": [
        {
          "action": "replace",
          "if_match": "\"zone-draft:d1:1\"",
          "zones": [
            "square"
          ],
          "expected": {
            "status": 200,
            "revision": 2
          }
        },
        {
          "action": "replace",
          "if_match": "\"zone-draft:d1:1\"",
          "zones": [
            "adjacent"
          ],
          "expected": {
            "status": 412,
            "code": "revision_conflict",
            "revision": 2
          }
        }
      ]
    },
    {
      "id": "two_publications",
      "given": {
        "current": "20000000-0000-4000-8000-000000000001",
        "drafts": [
          "d1",
          "d2"
        ]
      },
      "steps": [
        {
          "action": "publish",
          "draft": "d1",
          "request_id": "pub-1",
          "expected_current": "20000000-0000-4000-8000-000000000001",
          "expected": {
            "status": 201,
            "package": "20000000-0000-4000-8000-000000000002",
            "current": "20000000-0000-4000-8000-000000000002",
            "replayed": false
          }
        },
        {
          "action": "publish",
          "draft": "d2",
          "request_id": "pub-2",
          "expected_current": "20000000-0000-4000-8000-000000000001",
          "expected": {
            "status": 409,
            "code": "publication_conflict",
            "current": "20000000-0000-4000-8000-000000000002"
          }
        }
      ]
    },
