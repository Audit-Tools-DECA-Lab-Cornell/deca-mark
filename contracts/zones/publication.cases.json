      },
      "steps": [
        {
          "action": "publish",
          "draft": "d1",
          "request_id": "pub-1",
          "if_match": "\"zone-draft:d1:1\"",
          "expected_current": "20000000-0000-4000-8000-000000000007",
          "expected": {
            "status": 200,
            "package": "20000000-0000-4000-8000-000000000008",
            "current": "20000000-0000-4000-8000-000000000009",
            "new_versions": 0
          }
        }
      ]
    },
