{
	"name": "decamark-web",
	"description": "Offline field collection prototype with QGIS and ArcGIS handoff",
	"author": "@pratyush1712",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/pratyush1712/ArcGIS"
	},
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"test:api-errors": "node --experimental-strip-types --test tests/api-errors.test.mjs",
		"api:types": "openapi-typescript ../contracts/openapi.json -o src/lib/api/schema.d.ts",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck && pnpm lint",
		"lint": "eslint",
		"lint:fix": "eslint . --fix",
		"format": "pnpm run lint:fix && prettier --write .",
		"format:check": "prettier --check .",
		"test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
		"test:auth:local": "node --experimental-strip-types --test tests/auth-local.test.mjs",
		"test:account": "node --experimental-strip-types --test tests/profile-answer.test.mjs tests/data-export.test.mjs",
		"test:unit": "node --experimental-strip-types --test \"tests/unit/*.test.mjs\"",
		"test:e2e": "playwright test",
		"test:specimen": "playwright test -c playwright.specimen.config.ts"
	},
	"dependencies": {
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.117.2",
		"cmdk": "^1.1.1",
		"fflate": "0.8.2",
		"lucide-react": "^1.51.0",
		"next": "16.2.7",
		"openapi-fetch": "0.17.0",
		"radix-ui": "^1.6.7",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"server-only": "0.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/eslintrc": "^3.3.5",
		"@playwright/test": "1.56.1",
		"@tailwindcss/postcss": "^4",
		"@tsconfig/recommended": "^1.0.13",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.7",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.8.4",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "pnpm@10.17.1"
}
