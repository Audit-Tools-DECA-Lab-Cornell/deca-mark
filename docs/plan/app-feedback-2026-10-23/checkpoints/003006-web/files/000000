"use client";

import { useId, useState } from "react";

import { Field } from "@/components/contour/Field";
import { Select } from "@/components/contour/Select";
import { TextInput } from "@/components/contour/TextInput";
import { captureTimeValue, type DateTimeConfig, formatTemporalValue, resolveLocalDateTime } from "@/lib/forms/temporal";

export function PreviewTemporalInput({ config, value, onChange }: {
	config: DateTimeConfig;
	value: string | undefined;
	onChange: (value: string | undefined) => void;
}) {
	const id = useId();
	const [date, setDate] = useState(() => config.mode === "date" ? value ?? "" : value ? captureTimeValue({ ...config, mode: "date" }, value) ?? "" : "");
	const [time, setTime] = useState(() => config.mode === "time" ? value ?? "" : value ? captureTimeValue({ ...config, mode: "time" }, value) ?? "" : "");
	const [occurrence, setOccurrence] = useState<"earlier" | "later" | "">("");
	const result = config.mode === "dateTime" && date && time ? resolveLocalDateTime(`${date}T${time.length === 5 ? `${time}:00` : time}`, config.timeZone, occurrence || undefined) : null;
	const error = result && !result.ok ? result.reason === "ambiguous" ? "This time occurs twice. Choose which occurrence." : result.reason === "nonexistent" ? "This time does not exist in this time zone. Choose another time." : "Enter a valid date and time." : undefined;
	function commit(nextDate: string, nextTime: string, choice: "earlier" | "later" | "") {
		if (config.mode === "date") return onChange(nextDate || undefined);
		if (config.mode === "time") return onChange(nextTime ? nextTime.length === 5 ? `${nextTime}:00` : nextTime : undefined);
		if (!nextDate && !nextTime) return onChange(undefined);
		const local = `${nextDate}T${nextTime.length === 5 ? `${nextTime}:00` : nextTime}`;
		const resolved = resolveLocalDateTime(local, config.timeZone, choice || undefined);
		onChange(resolved.ok ? resolved.value : local);
	}
	return <div className="mt-4 flex flex-col gap-3">
		{config.mode !== "time" && <Field label="Date" htmlFor={`${id}-date`}>
			<TextInput type="date" min="0001-01-01" max="9999-12-31" value={date} onChange={event => { setDate(event.target.value); setOccurrence(""); commit(event.target.value, time, ""); }} />
		</Field>}
		{config.mode !== "date" && <Field label="Time" htmlFor={`${id}-time`} error={error}>
			<TextInput type="time" step={1} value={time} onChange={event => { setTime(event.target.value); setOccurrence(""); commit(date, event.target.value, ""); }} />
		</Field>}
		{result && !result.ok && result.reason === "ambiguous" && <Field label="Time occurrence" htmlFor={`${id}-occurrence`}>
			<Select value={occurrence} onChange={event => { const choice = event.target.value === "earlier" ? "earlier" : event.target.value === "later" ? "later" : ""; setOccurrence(choice); commit(date, time, choice); }}>
				<option value="">Choose an occurrence</option><option value="earlier">First occurrence</option><option value="later">Second occurrence</option>
			</Select>
		</Field>}
		<p className="type-small text-ink-2">{config.timeZone}{value && !error ? ` · ${formatTemporalValue(config, value)}` : ""}</p>
	</div>;
}
