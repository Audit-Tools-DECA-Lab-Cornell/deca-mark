import { strToU8 } from "fflate";
import { expect, it } from "vitest";
import { installPackage, readCatalog } from "../../storage/package-catalog";
import { boundFixture, ids } from "./bound-fixture";
import { packageIdentity, readInstalledPackage } from "./installation";
import { harness, hash, issuer, owner } from "./lifecycle.test-helper";
import { preparePackage } from "./prepare";

it("keeps unsupported installed form bytes and advertises update required without deleting its grant", async () => {
  const h = await harness();
  try {
    const f = boundFixture();
    const stored = await preparePackage(ids.project, f.site, f.source);
    const retained = JSON.stringify({ ...stored, formSchemaVersions: { play: 99, inventory: null } });
    const identity = packageIdentity(issuer, stored);
    const entry = { identity, contentPath: "retained/schema99.json", metadata: { contentSha256: await hash(strToU8(retained)), savedAt: stored.savedAt, archiveBytes: stored.archiveBytes } };
    h.files.stage(entry.contentPath, retained);
    await installPackage(h.database, owner, entry);
    await expect(readInstalledPackage(h.database, owner, identity, h.files, hash)).rejects.toMatchObject({ code: "unknown_schema_version" });
    expect(await h.operations.catalog()).toMatchObject([{ status: "update_required", identity }]);
    expect(await readCatalog(h.database, owner, identity)).toEqual(entry);
    expect(h.files.read(entry.contentPath)).toBe(retained);
  } finally {
    h.close();
  }
});
