import {
  FORM_SCHEMA_VERSION,
  formDefinitionSchema,
  questionSchema,
  type FormDefinition,
  parseServedDefinition,
  UnknownSchemaVersionError,
} from "../../forms/definition";

/** Old installed packages stored canonical schema1 JSON, but omitted the adjacent version.
 * Only that exact layout may move forward; previously ignored extension keys must never gain meaning.
 */
export function cachedForm(schemaVersion: number | undefined, definition: Record<string, unknown>): FormDefinition {
  if (schemaVersion === FORM_SCHEMA_VERSION)
    return parseServedDefinition(schemaVersion, definition);
  if (schemaVersion !== undefined && schemaVersion !== 1)
    throw new UnknownSchemaVersionError(schemaVersion);
  const extensions = new Set(["numberMode", "valueSource", "dateTime", "columnNaming"]);
  const hasExtension = (value: unknown): boolean => {
    if (Array.isArray(value)) return value.some(hasExtension);
    if (typeof value !== "object" || value === null) return false;
    return Object.entries(value).some(([key, child]) => extensions.has(key) || hasExtension(child));
  };
  const known = formDefinitionSchema.strict().extend({ questions: questionSchema.strict().array().min(1) }).safeParse(definition);
  if (!known.success || hasExtension(definition)) throw new UnknownSchemaVersionError(schemaVersion);
  return parseServedDefinition(FORM_SCHEMA_VERSION, definition);
}
