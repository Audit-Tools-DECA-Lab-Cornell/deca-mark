"use client";

import { useId } from "react";

import { Field } from "@/components/contour/Field";
import { Select } from "@/components/contour/Select";
import { TextInput } from "@/components/contour/TextInput";
import type { Condition } from "@/lib/forms";

import type { RawQuestion } from "./raw";

type Rule = Exclude<Condition, { kind: "all" | "any" }>;
const OPERATORS = [
	{ kind: "answered", label: "Has an answer" },
	{ kind: "equals", label: "Equals" },
	{ kind: "notEquals", label: "Does not equal" },
	{ kind: "includes", label: "Includes" }
] as const;

export function ConditionRuleEditor({
	value,
	earlier,
	readOnly,
	onChange
}: {
	value: Rule;
	earlier: readonly RawQuestion[];
	readOnly: boolean;
	onChange: (condition: Condition) => void;
}) {
	const id = useId();
	const target = earlier.find(question => question.id === value.question);
	const options = target?.dynamicFrom
		? Object.values(target.dynamicFrom.sets).flatMap(set => set.options)
		: (target?.options ?? []);
	const uniqueOptions = [...new Map(options.map(option => [option.code, option])).values()];
	const operators = OPERATORS.filter(
		operator =>
			operator.kind === "answered" ||
			(target?.kind === "many"
				? operator.kind === "includes"
				: target?.kind !== "number" && operator.kind !== "includes")
	);
	function changeOperator(kind: string) {
		if (kind === "answered") onChange({ kind, question: value.question });
		else if (kind === "equals" || kind === "notEquals" || kind === "includes")
			onChange({
				kind,
				question: value.question,
				option: "option" in value ? value.option : (uniqueOptions[0]?.code ?? "")
			});
	}
	return (
		<div className="flex min-w-0 flex-col gap-3">
			<Field label="Earlier question" htmlFor={`${id}-question`}>
				{readOnly ? (
					<TextInput value={target ? `${target.label} (${target.id})` : value.question} readOnly />
				) : (
					<Select
						value={value.question}
						onChange={event => onChange({ kind: "answered", question: event.target.value })}>
						{!target && (
							<option value={value.question}>{value.question} — choose an earlier question</option>
						)}
						{earlier.map(question => (
							<option key={question.id} value={question.id}>
								{question.label} ({question.id})
							</option>
						))}
					</Select>
				)}
			</Field>
			<Field label="Condition" htmlFor={`${id}-operator`}>
				{readOnly ? (
					<TextInput
						readOnly
						value={OPERATORS.find(operator => operator.kind === value.kind)?.label ?? value.kind}
					/>
				) : (
					<Select value={value.kind} onChange={event => changeOperator(event.target.value)}>
						{!operators.some(operator => operator.kind === value.kind) && (
							<option value={value.kind}>
								{OPERATORS.find(operator => operator.kind === value.kind)?.label} — choose a supported
								condition
							</option>
						)}
						{operators.map(operator => (
							<option key={operator.kind} value={operator.kind}>
								{operator.label}
							</option>
						))}
					</Select>
				)}
			</Field>
			{value.kind !== "answered" && (
				<Field
					label="Answer"
					htmlFor={`${id}-option`}
					error={
						!readOnly && value.option.trim() === ""
							? "Choose or enter an answer for this condition."
							: undefined
					}>
					{readOnly ? (
						<TextInput
							readOnly
							value={uniqueOptions.find(option => option.code === value.option)?.label ?? value.option}
						/>
					) : uniqueOptions.length > 0 ? (
						<Select
							value={value.option}
							onChange={event => onChange({ ...value, option: event.target.value })}>
							{!uniqueOptions.some(option => option.code === value.option) && (
								<option value={value.option}>{value.option || "Choose an answer"}</option>
							)}
							{uniqueOptions.map(option => (
								<option key={option.code} value={option.code}>
									{option.label}
								</option>
							))}
						</Select>
					) : (
						<TextInput
							value={value.option}
							onChange={event => onChange({ ...value, option: event.target.value })}
						/>
					)}
				</Field>
			)}
		</div>
	);
}
