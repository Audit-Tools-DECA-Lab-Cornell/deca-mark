import { act, create } from "react-test-renderer";
import { expect, it, vi } from "vitest";
import { parseFormDefinition } from "../../forms/definition";
import { reviewProblems } from "../../forms/engine";
import { reduceSession, startSession } from "../../forms/session";
import type { DateTimeConfig } from "../../forms/temporal";
import { TemporalInput } from "./TemporalInput";

vi.mock("../../ui", () => ({ TextInput: "Input", Text: "Text", Button: "Button" }));
for (const [mode, raw] of [["time", "13:00:00"], ["date", "2026-10-24"]] as const) {
 it(`refuses canonical-looking ${mode} entered against another display format through draft restart`, async () => {
  const config: DateTimeConfig = { mode, timeFormat: "12h", dateFormat: "monthFirst", timeZone: "UTC" };
  const form = parseFormDefinition({ version: "temporal-test", title: "Temporal", summary: "test", source: "test", status: "published", inclusion: "test", questions: [{ id: "when", code: "when", exportColumn: "when", act: "Record", label: "When", source: "test", kind: "dateTime", dateTime: config }] });
  const write = vi.fn<(value: string) => void>();
  let renderer: ReturnType<typeof create>;
  await act(async () => { renderer = create(<TemporalInput config={config} label="When" value="" onWrite={write} />); });
  await act(async () => { renderer.root.findByType("Input").props.onChangeText(raw); });
  const encoded = write.mock.calls.at(-1)?.[0];
  expect(encoded).toBeDefined();
  if (encoded === undefined) throw new Error("Input was not persisted");
  const draft = reduceSession(form, startSession(), { kind: "write", question: "when", value: encoded }).state;
  expect(reviewProblems(form, draft.answers)).toMatchObject([{ reason: "range" }]);
  const restored: unknown = JSON.parse(JSON.stringify(draft.answers));
  const restarted = typeof restored === "object" && restored !== null && "when" in restored && typeof restored.when === "string" ? restored.when : "";
  await act(async () => { renderer.unmount(); renderer = create(<TemporalInput config={config} label="When" value={restarted} onWrite={write} />); });
  expect(renderer.root.findByType("Input").props.value).toBe(raw);
  expect(reviewProblems(form, { when: restarted })).toMatchObject([{ reason: "range" }]);
  await act(async () => { renderer.unmount(); });
 });
}
