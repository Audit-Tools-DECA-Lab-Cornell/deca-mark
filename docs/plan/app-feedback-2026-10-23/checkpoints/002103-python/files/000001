"""Current serving/writing gate; historical uploads and exports retain their own parser."""

from pydantic import JsonValue

from fieldmaps_api.domain.form_definition import FORM_SCHEMA_VERSION
from fieldmaps_api.errors import DomainError


def require_current_schema(value: JsonValue) -> None:
    if type(value) not in (int, float) or value != FORM_SCHEMA_VERSION:
        raise DomainError(
            "unknown_schema_version",
            "Update DECA Mark to use this form",
            422,
            {"schema_version": value},
        )
