"use client";

import { useId, useState } from "react";

import { Field } from "@/components/contour/Field";
import { TextInput } from "@/components/contour/TextInput";

import type { QuestionPatch } from "./QuestionSettings";
import type { RawQuestion } from "./raw";

function boundValue(text: string): number | undefined {
	if (text.trim() === "") return undefined;
	return /^-?\d+$/.test(text) && Number.isSafeInteger(Number(text)) ? Number(text) : Number.NaN;
}

export function boundsProblem(question: RawQuestion): string | null {
	if (question.kind !== "number") return null;
	if ([question.min, question.max].some(value => value !== undefined && !Number.isSafeInteger(value))) return "Enter whole-number bounds within the supported range, or leave them blank.";
	if (question.min !== undefined && question.max !== undefined && question.min > question.max) return "Minimum must be less than or equal to maximum.";
	return null;
}

export function NumberBoundsEditor({ question, readOnly, onChange }: {
	question: RawQuestion;
	readOnly: boolean;
	onChange: (patch: QuestionPatch) => void;
}) {
	const id = useId();
	const [minimum, setMinimum] = useState(question.min?.toString() ?? "");
	const [maximum, setMaximum] = useState(question.max?.toString() ?? "");
	const problem = boundsProblem(question);
	return <fieldset className="flex flex-col gap-3">
		<legend className="mb-3 type-small font-semibold text-ink">Number range</legend>
		<p className="type-small text-ink-2">Leave both blank for no range limit.</p>
		<div className="grid min-w-0 grid-cols-1 gap-4 sm:grid-cols-2">
			<Field label="Minimum" htmlFor={`${id}-min`} optional error={problem ?? undefined}>
				<TextInput inputMode="numeric" value={minimum} readOnly={readOnly} placeholder="No minimum" onChange={event => { setMinimum(event.target.value); onChange({ min: boundValue(event.target.value) }); }} />
			</Field>
			<Field label="Maximum" htmlFor={`${id}-max`} optional>
				<TextInput inputMode="numeric" value={maximum} readOnly={readOnly} placeholder="No maximum" onChange={event => { setMaximum(event.target.value); onChange({ max: boundValue(event.target.value) }); }} />
			</Field>
		</div>
	</fieldset>;
}
