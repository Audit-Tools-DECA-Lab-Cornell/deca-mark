import { DatabaseSync } from "node:sqlite";
import { afterEach, beforeEach, expect, it, vi } from "vitest";
import type { SitePackage } from "../packages/site-package";
import { hasDraft, observationDraftSchema, readDraft, saveDraft } from "../storage/draft-store";
import { initializeDatabase, type LocalDatabase } from "../storage/observation-store";
import { adapter, boundDraft, identity, owner } from "../storage/package-store.fixture";
import { packageActions } from "./package-actions";

const mocks = vi.hoisted(() => ({
  open: vi.fn<(_id: string) => Promise<SitePackage | undefined>>(),
}));
vi.mock("../packages/open", () => ({ openSitePackage: mocks.open }));

const draft = observationDraftSchema.parse({
  ...boundDraft,
  binding: undefined,
  formVersion: "janet-test-v1",
});
const style: SitePackage["bases"]["day"] = { version: 8, sources: {}, layers: [] };
const pkg: SitePackage = {
  id: draft.packageId,
  name: "Synthetic map v7",
  meta: "Synthetic",
  availability: "on-device",
  formVersion: draft.formVersion,
  inventoryFormVersion: "janet-inventory-v1",
  version: "v7",
  siteId: draft.siteId,
  sizeOnDevice: "Synthetic",
  inheritedContext: "",
  centre: [0.5, 0.5],
  bounds: [0, 0, 1, 1],
  bases: { day: style, night: style, aerial: style },
  layers: [],
  zones: [
    {
      zoneId: "practice:A",
      displayAnchor: [0.5, 0.5],
      polygon: [
        [
          [0, 0],
          [1, 0],
          [1, 1],
          [0, 1],
          [0, 0],
        ],
      ],
      id: "A",
      label: "Old label",
      centre: [0.5, 0.5],
      west: 0,
      south: 0,
      east: 1,
      north: 1,
    },
  ],
};
let sqlite: DatabaseSync;
let database: LocalDatabase;
beforeEach(async () => {
  sqlite = new DatabaseSync(":memory:");
  database = adapter(sqlite);
  await initializeDatabase(database);
  mocks.open.mockReset();
  mocks.open.mockResolvedValue(pkg);
});
afterEach(() => sqlite.close());
function actions(overrides: Partial<Parameters<typeof packageActions>[0]> = {}) {
  const input: Parameters<typeof packageActions>[0] = {
    database,
    key: owner,
    identity: { current: null },
    current: () => true,
    recovered: null,
    sites: {},
    installed: [],
    zone: null,
    roundType: "standard",
    freshPeriod: false,
    opened: vi.fn(),
    setRecovered: vi.fn(),
    setUnreadableDraft: vi.fn(),
    setStatus: vi.fn(),
    ...overrides,
  };
  return { ...packageActions(input), input };
}

it("blocks a corrupt durable draft until explicit discard removes the raw row", async () => {
  const raw = "{ retained corrupt answers";
  await database.runAsync(
    "INSERT INTO observation_drafts (owner_scope, id, updated_at, payload) VALUES (?, ?, ?, ?)",
    owner,
    draft.id,
    draft.updatedAt,
    raw,
  );
  const flow = actions();
  expect(await flow.openPackage(pkg.id)).toMatchObject({
    ok: false,
    reason: "Resume or discard the unfinished observation first.",
  });
  expect(mocks.open).not.toHaveBeenCalled();
  expect(await hasDraft(database, owner)).toBe(true);
  expect(
    sqlite.prepare("SELECT payload FROM observation_drafts WHERE owner_scope = ?").get(owner),
  ).toEqual({ payload: raw });
  await flow.discardRecovered();
  expect(await hasDraft(database, owner)).toBe(false);
  expect(flow.input.setUnreadableDraft).toHaveBeenCalledWith(false);
  expect(await flow.openPackage(pkg.id)).toMatchObject({ ok: true });
  expect(flow.input.opened).toHaveBeenCalledOnce();
});

const missingVersions: readonly (SitePackage | undefined)[] = [
  {
    ...pkg,
    zones: [
      {
        zoneId: "practice:B",
        displayAnchor: [0.5, 0.5],
        polygon: [
          [
            [0, 0],
            [1, 0],
            [1, 1],
            [0, 1],
            [0, 0],
          ],
        ],
        id: "B",
        label: "Replacement",
        centre: [0.5, 0.5],
        west: 0,
        south: 0,
        east: 1,
        north: 1,
      },
    ],
  },
  { ...pkg, formVersion: "janet-test-v2" },
  { ...pkg, version: "v8" },
  undefined,
];
it.each(
  missingVersions,
)("retains exact recovered draft bytes when its zone, form, version or package is unavailable: %j", async (opened) => {
  await saveDraft(database, owner, draft);
  const before = sqlite
    .prepare("SELECT payload FROM observation_drafts WHERE owner_scope = ?")
    .get(owner);
  mocks.open.mockResolvedValue(opened);
  const flow = actions({ recovered: await readDraft(database, owner) });
  expect(await flow.resumeRecovered()).toBeUndefined();
  expect(mocks.open).toHaveBeenCalledExactlyOnceWith(draft.packageId);
  expect(flow.input.opened).not.toHaveBeenCalled();
  expect(flow.input.setRecovered).not.toHaveBeenCalled();
  expect(
    sqlite.prepare("SELECT payload FROM observation_drafts WHERE owner_scope = ?").get(owner),
  ).toEqual(before);
  expect(await readDraft(database, owner)).toEqual(draft);
});

it("refuses managed collection without verified identity or full geometry", async () => {
  mocks.open.mockResolvedValue({ ...pkg, projectId: "10000000-0000-4000-8000-000000000001" });
  const flow = actions();
  expect(await flow.openPackage(pkg.id)).toMatchObject({
    ok: false,
    reason: expect.stringContaining("no verified"),
  });
  expect(mocks.open).toHaveBeenCalledExactlyOnceWith(pkg.id);
  expect(flow.input.opened).not.toHaveBeenCalled();
  expect(await hasDraft(database, owner)).toBe(false);
  expect(sqlite.prepare("SELECT COUNT(*) total FROM observations").get()).toEqual({ total: 0 });
});

it("rejects an expired account generation while waiting for package open", async () => {
  let current = true;
  let release: (value: SitePackage) => void = () => {
    throw new Error("Open not started");
  };
  const pending = new Promise<SitePackage>((resolve) => {
    release = resolve;
  });
  mocks.open.mockReturnValue(pending);
  const flow = actions({ current: () => current });
  const opening = flow.openPackage(pkg.id);
  await vi.waitFor(() => expect(mocks.open).toHaveBeenCalledOnce());
  current = false;
  release(pkg);
  expect(await opening).toMatchObject({
    ok: false,
    reason: "The account changed while opening the map.",
  });
  expect(flow.input.opened).not.toHaveBeenCalled();
});

it("refuses unsupported installed forms with an update action and retains a recovered draft", async () => {
  const flow = actions({ installed: [{ identity, status: "update_required", installedAt: null, bytes: 1, counts: { unfinished: 0, unsent: 0, attention: 0, retained: 0, openSession: false }, references: { sessions: 0, drafts: 0, records: 0 } }] });
  expect(await flow.openPackage(pkg.id)).toMatchObject({ ok: false, reason: expect.stringMatching(/Update DECA Mark/) });
  await saveDraft(database, owner, draft);
  expect(await flow.resumeRecovered(draft)).toBeUndefined();
  expect(flow.input.setStatus).toHaveBeenCalledWith(expect.stringMatching(/Update DECA Mark/));
  expect(await readDraft(database, owner)).toEqual(draft);
  expect(mocks.open).not.toHaveBeenCalled();
});
