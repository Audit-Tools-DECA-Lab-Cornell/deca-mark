"use client";

import { useId, useState } from "react";

import { Field } from "@/components/contour/Field";
import { TextInput } from "@/components/contour/TextInput";

import { numericInput } from "./numeric-input";
import type { QuestionPatch } from "./QuestionSettings";
import type { RawQuestion } from "./raw";

function invalidBound(decimal: boolean): string {
	return decimal ? "Enter a finite number, or leave it blank." : "Enter a whole number within the supported range, or leave it blank.";
}
function validBound(value: number, decimal: boolean): boolean {
	return decimal ? Number.isFinite(value) : Number.isSafeInteger(value);
}
export function boundsProblem(question: RawQuestion): string | null {
	if (question.kind !== "number") return null;
	if ([question.min, question.max].some(value => value !== undefined && !validBound(value, question.numberMode === "decimal")))
		return invalidBound(question.numberMode === "decimal");
	if (question.min !== undefined && question.max !== undefined && question.min > question.max)
		return "Minimum must be less than or equal to maximum.";
	return null;
}

function BoundInput({
	value,
	decimal,
	readOnly,
	placeholder,
	onChange
}: {
	value: number | undefined;
	decimal: boolean;
	readOnly: boolean;
	placeholder: string;
	onChange: (value: number | undefined) => void;
}) {
	const [buffer, setBuffer] = useState({ text: value?.toString() ?? "", value });
	if (!Object.is(value, buffer.value)) setBuffer({ text: value?.toString() ?? "", value });
	return (
		<TextInput
			inputMode={decimal ? "decimal" : "numeric"}
			value={buffer.text}
			readOnly={readOnly}
			placeholder={placeholder}
			onChange={event => {
				const next = numericInput(event.target.value, decimal);
				setBuffer({ text: event.target.value, value: next });
				onChange(next);
			}}
		/>
	);
}

export function NumberBoundsEditor({
	question,
	readOnly,
	onChange
}: {
	question: RawQuestion;
	readOnly: boolean;
	onChange: (patch: QuestionPatch) => void;
}) {
	const id = useId();
	const inverted = question.min !== undefined && question.max !== undefined && question.min > question.max;
	return (
		<fieldset className="flex flex-col gap-3">
			<legend className="mb-3 type-small font-semibold text-ink">Number range</legend>
			<p className="type-small text-ink-2">Leave both blank for no range limit.</p>
			<div className="grid min-w-0 grid-cols-1 gap-4 sm:grid-cols-2">
				<Field
					label="Minimum"
					htmlFor={`${id}-min`}
					optional
					error={
						!readOnly
							? question.min !== undefined && !validBound(question.min, question.numberMode === "decimal")
								? invalidBound(question.numberMode === "decimal")
								: inverted
									? "Minimum must be less than or equal to maximum."
									: undefined
							: undefined
					}>
					<BoundInput
						value={question.min}
						decimal={question.numberMode === "decimal"}
						readOnly={readOnly}
						placeholder="No minimum"
						onChange={min => onChange({ min })}
					/>
				</Field>
				<Field
					label="Maximum"
					htmlFor={`${id}-max`}
					optional
					error={
						!readOnly && question.max !== undefined && !validBound(question.max, question.numberMode === "decimal")
							? invalidBound(question.numberMode === "decimal")
							: undefined
					}>
					<BoundInput
						value={question.max}
						decimal={question.numberMode === "decimal"}
						readOnly={readOnly}
						placeholder="No maximum"
						onChange={max => onChange({ max })}
					/>
				</Field>
			</div>
		</fieldset>
	);
}
