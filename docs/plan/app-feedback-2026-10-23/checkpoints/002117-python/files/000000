"""Schema2 question-kind compatibility and explicit export provenance."""

from fieldmaps_api.domain.form_definition import CanonicalDefinition, Question, MAX_SAFE_INTEGER


def extended_question_problems(question: Question, form: CanonicalDefinition) -> list[str]:
    problems: list[str] = []
    if question.number_mode is not None and question.kind != "number":
        problems.append(f'"{question.id}" carries numberMode on a non-number question.')
    if question.kind == "number" and question.number_mode != "decimal":
        problems.extend(
            f'"{question.id}" requires safe integer bounds.'
            for bound in (question.min, question.max)
            if bound is not None and (int(bound) != bound or abs(bound) > MAX_SAFE_INTEGER)
        )
    if (question.kind == "dateTime") != (question.date_time is not None):
        problems.append(f'"{question.id}" requires dateTime configuration only on dateTime questions.')
    if question.value_source in {"accountId", "observerCode"} and question.kind != "text":
        problems.append(f'"{question.id}" requires text for its automatic value source.')
    if question.value_source == "captureTime" and question.kind != "dateTime":
        problems.append(f'"{question.id}" requires dateTime for captureTime.')
    if form.column_naming == "questionId" and (
        question.export_column != question.id or (question.dynamic_from is not None and any(
            group.export_column != question.id for group in question.dynamic_from.sets.values()
        ))
    ):
        problems.append(f'"{question.id}" requires question-ID export columns.')
    return problems
