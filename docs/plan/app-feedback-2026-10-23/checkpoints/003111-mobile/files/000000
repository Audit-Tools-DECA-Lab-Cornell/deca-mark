import { describe, expect, it } from "vitest";
import type { DateTimeConfig } from "../../forms/temporal";
import { parseTemporalInput } from "./temporal-input";
const config: DateTimeConfig = { mode: "dateTime", dateFormat: "monthFirst", timeFormat: "12h", timeZone: "America/New_York" };
describe("Configured native temporal entry", () => {
  it("canonicalizes the configured date order and twelve-hour clock", () => {
    expect(parseTemporalInput(config, "10/24/2026 2:03:04 PM")).toEqual({ ok: true, value: "2026-10-24T18:03:04.000Z" });
    expect(parseTemporalInput({ ...config, mode: "date", dateFormat: "dayFirst" }, "24/10/2026")).toEqual({ ok: true, value: "2026-10-24" });
    expect(parseTemporalInput({ ...config, mode: "time" }, "12:03:04 AM")).toEqual({ ok: true, value: "00:03:04" });
  });
  it("refuses nonexistent times and requires an occurrence for ambiguous times", () => {
    expect(parseTemporalInput(config, "03/08/2026 2:30:00 AM")).toMatchObject({ ok: false, reason: "nonexistent" });
    expect(parseTemporalInput(config, "11/01/2026 1:30:00 AM")).toMatchObject({ ok: false, reason: "ambiguous" });
    expect(parseTemporalInput(config, "11/01/2026 1:30:00 AM", "earlier")).toEqual({ ok: true, value: "2026-11-01T05:30:00.000Z" });
    expect(parseTemporalInput(config, "11/01/2026 1:30:00 AM", "later")).toEqual({ ok: true, value: "2026-11-01T06:30:00.000Z" });
  });
});
