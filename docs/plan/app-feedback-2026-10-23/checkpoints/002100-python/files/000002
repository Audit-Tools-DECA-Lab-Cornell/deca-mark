"""Schema2 authoring and answer boundaries, independent of database fixtures."""

import pytest
from pydantic import JsonValue, ValidationError

from fieldmaps_api.domain.forms import FormDefinition, review_problems
from tests.test_observation_analysis_domain import canonical, question


def form(patch: dict[str, JsonValue]) -> FormDefinition:
    return FormDefinition.model_validate(canonical([question("value", "value") | patch]))


def test_decimal_answer_retains_fraction_and_large_finite_numbers() -> None:
    # Given an explicitly decimal field.
    definition = form({"kind": "number", "numberMode": "decimal", "min": -1.5})
    # When finite decimals are reviewed, then neither rounding nor a safe-integer cap applies.
    assert review_problems(definition, {"value": 1.25}) == []
    assert review_problems(definition, {"value": 1e100}) == []


@pytest.mark.parametrize("value", [1.5, 9007199254740992, float("inf"), float("nan")])
def test_default_integer_answer_refuses_non_safe_integers(value: float) -> None:
    # Given an integer field, when an unsafe value is reviewed, then it is a range error.
    definition = form({"kind": "number"})
    assert [p.reason for p in review_problems(definition, {"value": value})] == ["range"]


@pytest.mark.parametrize(
    "patch",
    [
        {"numberMode": "decimal"},
        {"valueSource": "captureTime"},
        {"kind": "number", "valueSource": "accountId"},
        {"dateTime": {"mode": "date", "timeZone": "UTC"}},
        {"kind": "dateTime"},
        {"kind": "number", "min": 1.1},
        {"kind": "dateTime", "dateTime": {"mode": "time", "timeZone": "+05:30"}},
    ],
)
def test_incompatible_schema2_definition_is_refused(patch: dict[str, JsonValue]) -> None:
    # Given incompatible kind/configuration, when parsed, then authoring is refused.
    with pytest.raises(ValidationError):
        form(patch)


@pytest.mark.parametrize(
    ("mode", "value", "valid"),
    [
        ("date", "0001-01-01", True), ("date", "2024-02-29", True),
        ("date", "2025-02-29", False), ("date", "0000-01-01", False),
        ("time", "23:59:59", True), ("time", "24:00:00", False),
        ("time", "01:02", False), ("dateTime", "2026-10-24T12:00:00.123Z", True),
        ("dateTime", "2026-10-24T12:00:00+00:00", False),
        ("dateTime", "2026-10-24T12:00:00.1234Z", False),
        ("dateTime", "2026-02-30T12:00:00Z", False),
    ],
)
def test_canonical_temporal_answers(mode: str, value: str, valid: bool) -> None:
    # Given a configured temporal field.
    definition = form({"kind": "dateTime", "dateTime": {"mode": mode, "timeZone": "America/New_York"}})
    # When reviewing canonical strings, then real calendar and clock rules apply.
    assert (review_problems(definition, {"value": value}) == []) is valid
