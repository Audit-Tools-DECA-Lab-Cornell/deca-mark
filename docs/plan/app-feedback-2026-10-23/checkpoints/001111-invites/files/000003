import { z } from "zod";

import type { CreatedInvitation, InviteResult } from "./types";

export const DEFAULT_INVITATION_DAYS = 14;
export const MAX_RECIPIENTS = 25;
const addressSchema = z.email().max(254);

export type RecipientCheck =
	| { readonly ok: true; readonly addresses: readonly string[] }
	| { readonly ok: false; readonly message: string };

/** Parse the entire list before making any requests; duplicates use the API's lowercase identity. */
export function parseRecipients(input: string): RecipientCheck {
	const addresses = [...new Set(input.split(",").map(address => address.trim().toLowerCase()))];
	if (addresses.some(address => !addressSchema.safeParse(address).success))
		return { ok: false, message: "Enter full email addresses separated by commas. Check every address." };
	if (addresses.length > MAX_RECIPIENTS)
		return { ok: false, message: "Use at most 25 different email addresses per invitation batch." };
	return { ok: true, addresses };
}

export type RecipientResult = { readonly email: string | null } & (
	| { readonly status: "created"; readonly invitation: CreatedInvitation }
	| { readonly status: "failed"; readonly message: string; readonly fields?: Record<string, string> }
	| { readonly status: "unconfirmed"; readonly message: string }
);

const UNCONFIRMED =
	"Creation was not confirmed. Check the waiting invitations before creating another.";

/** Each existing create request stands alone. An uncertain write is never automatically repeated. */
export async function createInvitationBatch(
	addresses: readonly (string | null)[],
	create: (email: string | null) => Promise<InviteResult>,
	onResult?: (result: RecipientResult) => void
): Promise<RecipientResult[]> {
	const results: RecipientResult[] = [];
	let cursor = 0;
	async function worker() {
		while (cursor < addresses.length) {
			const index = cursor++;
			const email = addresses[index] ?? null;
			let result: RecipientResult;
			try {
				const outcome = await create(email);
				switch (outcome.status) {
					case "done":
						result = { email, status: "created", invitation: outcome.invitation };
						break;
					case "failed":
						result = outcome.definite
							? { email, status: "failed", message: outcome.message, fields: outcome.fields }
							: { email, status: "unconfirmed", message: UNCONFIRMED };
						break;
					default: {
						const unreachable: never = outcome;
						throw new TypeError(`Unknown invitation outcome: ${unreachable}`);
					}
				}
			} catch (error) {
				// This is the UI mutation boundary: even a lost action response may hide a committed write.
				if (!(error instanceof Error)) throw error;
				result = { email, status: "unconfirmed", message: UNCONFIRMED };
			}
			results[index] = result;
			onResult?.(result);
		}
	}
	await Promise.all(Array.from({ length: Math.min(3, addresses.length) }, () => worker()));
	return results;
}

/** Only a confirmed refusal proves that another create request cannot duplicate a write. */
export function retryableRecipients(results: readonly RecipientResult[]): (string | null)[] {
	return results.filter(result => result.status === "failed").map(result => result.email);
}
