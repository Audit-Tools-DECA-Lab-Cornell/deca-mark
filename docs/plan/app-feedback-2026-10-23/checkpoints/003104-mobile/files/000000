import { useState } from "react";
import { formatTemporalValue, type DateTimeConfig } from "../../forms/temporal";
import { Button, Text, TextInput } from "../../ui";
import { parseTemporalInput } from "./temporal-input";

export function TemporalInput({ config, value, label, onWrite }: {
  readonly config: DateTimeConfig;
  readonly value: string;
  readonly label: string;
  readonly onWrite: (value: string) => void;
}) {
  const [text, setText] = useState(() => formatTemporalValue(config, value));
  const [problem, setProblem] = useState("");
  const [ambiguous, setAmbiguous] = useState(false);
  const date = config.dateFormat === "iso" ? "YYYY-MM-DD" : config.dateFormat === "monthFirst" ? "MM/DD/YYYY" : "DD/MM/YYYY";
  const time = config.timeFormat === "12h" ? "h:mm:ss AM/PM" : "HH:mm:ss";
  const hint = config.mode === "date" ? date : config.mode === "time" ? time : `${date} ${time}`;
  function change(next: string, occurrence?: "earlier" | "later") {
    setText(next);
    const parsed = parseTemporalInput(config, next, occurrence);
    setAmbiguous(!parsed.ok && parsed.reason === "ambiguous");
    setProblem(parsed.ok || !next ? "" : parsed.reason === "nonexistent" ? "This local time does not exist. Choose another time." : parsed.reason === "ambiguous" ? "This time occurs twice. Choose an occurrence." : `Enter ${hint}.`);
    // Retain incomplete input in the durable draft; review refuses noncanonical values.
    onWrite(parsed.ok ? parsed.value : next);
  }
  return <>
    <Text tone="ink2">{`${hint} · ${config.timeZone}`}</Text>
    <TextInput accessibilityLabel={label} value={text} onChangeText={(next) => change(next)} placeholder={hint} autoCapitalize="none" autoCorrect={false} />
    {problem ? <Text tone="ink2">{problem}</Text> : null}
    {ambiguous ? <>
      <Button label="First occurrence" variant="outline" onPress={() => change(text, "earlier")} />
      <Button label="Second occurrence" variant="outline" onPress={() => change(text, "later")} />
    </> : null}
  </>;
}
