"use client";

import { useId } from "react";

import { Button } from "@/components/contour/Button";
import { Checkbox } from "@/components/contour/Checkbox";
import { Field } from "@/components/contour/Field";
import { Note } from "@/components/contour/Note";
import { Select } from "@/components/contour/Select";
import { TextInput } from "@/components/contour/TextInput";

import { ConditionEditor } from "./ConditionEditor";
import { DynamicOptionsEditor } from "./DynamicOptionsEditor";
import { FORMAT_LABEL, questionChanges } from "./model";
import { boundsProblem, NumberBoundsEditor } from "./NumberBoundsEditor";
import { optionListProblem } from "./OptionsEditor";
import { QuestionIdEditor } from "./QuestionIdEditor";
import { ADDED_SOURCE, type QuestionKind, type RawQuestion, STARTER_OPTIONS } from "./raw";

export type QuestionPatch = Partial<Omit<RawQuestion, "id">>;
export const MIN_CHOICE_OPTIONS = 2;
const KINDS = ["one", "many", "text", "number"] as const;

export function formatPatch(question: RawQuestion, kind: QuestionKind): QuestionPatch {
	if (kind === "one" || kind === "many") {
		const options = question.options?.length ? question.options : [...STARTER_OPTIONS];
		return { kind, options, columns: question.columns ?? 2, maxLength: undefined, min: undefined, max: undefined };
	}
	if (kind === "text") return { kind, options: undefined, dynamicFrom: undefined, optionsPending: undefined, columns: undefined, maxLength: question.maxLength ?? 200, min: undefined, max: undefined };
	return { kind, options: undefined, dynamicFrom: undefined, optionsPending: undefined, columns: undefined, maxLength: undefined, min: undefined, max: undefined };
}

export function optionsProblem(question: RawQuestion): string | null {
	if (question.kind !== "one" && question.kind !== "many") return null;
	if (question.dynamicFrom) {
		const sets = Object.values(question.dynamicFrom.sets);
		if (sets.length === 0) return "Add an option list for the controlling question's answers.";
		for (const set of sets) {
			const problem = optionListProblem(set.options);
			if (problem) return `${set.label}: ${problem}`;
		}
		return null;
	}
	return optionListProblem(question.options ?? [], MIN_CHOICE_OPTIONS);
}

export function isOpenQuestion(question: RawQuestion, base: RawQuestion | undefined): boolean {
	return question.source === ADDED_SOURCE && base === undefined;
}

export function saveProblem(question: RawQuestion, _base?: RawQuestion): string | null {
	if (question.label.trim() === "") return "Enter the question text first.";
	return boundsProblem(question) ?? optionsProblem(question);
}

const SHOWN = new Set(["label", "hint", "options", "required", "kind", "min", "max"]);

export function QuestionSettings({ question, questions, base, baseVersion, readOnly, problems, onChange, onRename, onRemove }: {
	question: RawQuestion;
	questions: readonly RawQuestion[];
	base: RawQuestion | undefined;
	baseVersion: string | null;
	readOnly: boolean;
	problems: Readonly<Record<string, string>>;
	onChange: (patch: QuestionPatch) => void;
	onRename: (nextId: string) => string | null;
	onRemove?: () => void;
}) {
	const id = useId();
	const added = !readOnly && isOpenQuestion(question, base);
	const wording = questionChanges(question, base).filter(change => change.field === "Question Text" || change.field === "Instructions to Observers" || change.field === "Response required when question is visible");
	const earlier = questions.slice(0, Math.max(0, questions.findIndex(candidate => candidate.id === question.id)));
	const otherProblems = Object.entries(problems).filter(([property]) => !SHOWN.has(property));
	return <div className="flex min-w-0 flex-col gap-6">
		<Field label="Question Text" htmlFor={`${id}-label`} error={!readOnly ? question.label.trim() === "" ? "Enter the question as observers read it." : problems.label : undefined}>
			<TextInput value={question.label} readOnly={readOnly} onChange={event => onChange({ label: event.target.value })} />
		</Field>
		<QuestionIdEditor key={question.id} value={question.id} readOnly={readOnly} onRename={onRename} />
		<Field label="Instructions to Observers" htmlFor={`${id}-guidance`} optional error={!readOnly ? problems.hint : undefined}>
			<TextInput value={question.hint ?? ""} readOnly={readOnly} onChange={event => onChange({ hint: event.target.value || undefined })} />
		</Field>
		{baseVersion && wording.length > 0 && base && <Note tone="waiting" icon="pencil" live="polite">
			<p className="font-semibold text-waiting">Changed from {baseVersion}</p>
			{wording.map(change => <p key={change.field} className="mt-1">{wording.length > 1 ? `${change.field} was: ` : "Was: "}“{change.was}”</p>)}
		</Note>}
		{!base && baseVersion && <Note tone="waiting" icon="pencil"><p className="font-semibold text-waiting">New in this version</p><p className="mt-1">{baseVersion} does not have this question, so no earlier observation answers it.</p></Note>}
		<Field label="Answer format" htmlFor={`${id}-format`}>
			{added ? <Select value={question.kind} onChange={event => {
				const kind = KINDS.find(candidate => candidate === event.target.value);
				if (kind) onChange(formatPatch(question, kind));
			}}>{KINDS.map(kind => <option key={kind} value={kind}>{FORMAT_LABEL[kind]}</option>)}</Select> : <TextInput value={FORMAT_LABEL[question.kind]} readOnly />}
		</Field>
		{(question.kind === "one" || question.kind === "many") && <DynamicOptionsEditor question={question} earlier={earlier} readOnly={readOnly} problem={problems.options} onChange={onChange} />}
		{question.kind === "number" && <NumberBoundsEditor key={question.id} question={question} readOnly={readOnly} onChange={onChange} />}
		{question.kind === "text" && question.maxLength !== undefined && <p className="type-small text-ink-2">Written answers can contain up to {question.maxLength} characters.</p>}
		<Checkbox id={`${id}-required`} checked={question.required ?? false} disabled={readOnly} onCheckedChange={required => onChange({ required })}>Response required when question is visible</Checkbox>
		<ConditionEditor question={question} earlier={earlier} readOnly={readOnly} onChange={onChange} />
		{otherProblems.length > 0 && <Note tone="attention" title="The last save refused this question.">{otherProblems.map(([property, problem]) => <span key={property} className="block">{property}: {problem}</span>)}</Note>}
		{added && onRemove && <div className="border-t border-rule pt-6"><Button variant="danger" icon="trash-2" onClick={onRemove}>Remove question</Button><p className="mt-2 type-small text-ink-2">Only a question added in this draft can be removed. It leaves the draft when you save.</p></div>}
	</div>;
}
