import type { Condition } from "@/lib/forms";

import type { RawDefinition, RawQuestion } from "./raw";

export type QuestionEdit =
	| { readonly ok: true; readonly raw: RawDefinition; readonly id: string }
	| { readonly ok: false; readonly problem: string };

function conditionReferences(condition: Condition): readonly string[] {
	switch (condition.kind) {
		case "all":
		case "any":
			return condition.of.flatMap(conditionReferences);
		case "answered":
		case "equals":
		case "notEquals":
		case "includes":
			return [condition.question];
	}
}

function references(question: RawQuestion): readonly string[] {
	return [
		...(question.dependsOn ? conditionReferences(question.dependsOn) : []),
		...(question.dynamicFrom ? [question.dynamicFrom.question] : [])
	];
}

function renamedCondition(condition: Condition, before: string, after: string): Condition {
	switch (condition.kind) {
		case "all":
		case "any":
			return { ...condition, of: condition.of.map(part => renamedCondition(part, before, after)) };
		case "answered":
		case "equals":
		case "notEquals":
		case "includes":
			return condition.question === before ? { ...condition, question: after } : condition;
	}
}

export function questionIdColumns(raw: RawDefinition): RawDefinition {
	return {
		...raw,
		columnNaming: "questionId",
		questions: raw.questions.map(question => ({
			...question,
			exportColumn: question.id,
			...(question.dynamicFrom
				? {
						dynamicFrom: {
							...question.dynamicFrom,
							sets: Object.fromEntries(
								Object.entries(question.dynamicFrom.sets).map(([key, set]) => [
									key,
									{ ...set, exportColumn: question.id }
								])
							)
						}
					}
				: {})
		}))
	};
}

export function renameQuestion(raw: RawDefinition, before: string, value: string): QuestionEdit {
	const id = value.trim();
	if (!id) return { ok: false, problem: "Enter a Question ID." };
	if (id !== before && raw.questions.some(question => question.id === id))
		return { ok: false, problem: "Another question already uses this ID. Enter a different ID." };
	if (!raw.questions.some(question => question.id === before))
		return { ok: false, problem: "Choose the question again before changing its ID." };
	const questions = raw.questions.map(question => ({
		...question,
		...(question.id === before ? { id } : {}),
		...(question.dependsOn
			? { dependsOn: renamedCondition(question.dependsOn, before, id) }
			: {}),
		...(question.dynamicFrom?.question === before
			? { dynamicFrom: { ...question.dynamicFrom, question: id } }
			: {})
	}));
	return { ok: true, raw: questionIdColumns({ ...raw, questions }), id };
}

export function moveQuestion(raw: RawDefinition, id: string, target: number): QuestionEdit {
	const from = raw.questions.findIndex(question => question.id === id);
	const question = raw.questions[from];
	if (!question || !Number.isInteger(target) || target < 0 || target >= raw.questions.length)
		return { ok: false, problem: "Choose a position within this form." };
	const questions = [...raw.questions];
	questions.splice(from, 1);
	questions.splice(target, 0, question);
	const positions = new Map(questions.map((entry, index) => [entry.id, index]));
	for (const [index, entry] of questions.entries()) {
		for (const parentId of references(entry)) {
			const parentIndex = positions.get(parentId);
			if (parentIndex !== undefined && parentIndex >= index) {
				const parent = questions[parentIndex];
				return {
					ok: false,
					problem: `Keep “${entry.label}” after “${parent?.label ?? parentId}” because it uses that answer.`
				};
			}
		}
	}
	return { ok: true, raw: { ...raw, questions }, id };
}
