"""Schema2 authoring and answer boundaries, independent of database fixtures."""

from uuid import UUID

import pytest
from pydantic import JsonValue, ValidationError

from fieldmaps_api.domain.form_automatic import automatic_mismatches
from fieldmaps_api.domain.forms import FormDefinition, StoredCanonicalDefinition, review_problems
from fieldmaps_api.domain.stored_form_versions import historical_definition
from tests.test_observation_analysis_domain import canonical, question


def form(patch: dict[str, JsonValue]) -> FormDefinition:
    return FormDefinition.model_validate(canonical([question("value", "value") | patch]))


def test_decimal_answer_retains_fraction_and_large_finite_numbers() -> None:
    # Given an explicitly decimal field.
    definition = form({"kind": "number", "numberMode": "decimal", "min": -1.5})
    # When finite decimals are reviewed, then neither rounding nor a safe-integer cap applies.
    assert review_problems(definition, {"value": 1.25}) == []
    assert review_problems(definition, {"value": 1e100}) == []


@pytest.mark.parametrize("value", [1.5, 9007199254740992, float("inf"), float("nan")])
def test_default_integer_answer_refuses_non_safe_integers(value: float) -> None:
    # Given an integer field, when an unsafe value is reviewed, then it is a range error.
    definition = form({"kind": "number"})
    assert [p.reason for p in review_problems(definition, {"value": value})] == ["range"]


@pytest.mark.parametrize(
    "patch",
    [
        {"numberMode": "decimal"},
        {"min": 1.1},
        {"valueSource": "captureTime"},
        {"kind": "number", "valueSource": "accountId"},
        {"dateTime": {"mode": "date", "timeZone": "UTC"}},
        {"kind": "dateTime"},
        {"kind": "number", "min": 1.1},
        {"kind": "dateTime", "dateTime": {"mode": "time", "timeZone": "+05:30"}},
    ],
)
def test_incompatible_schema2_definition_is_refused(patch: dict[str, JsonValue]) -> None:
    # Given incompatible kind/configuration, when parsed, then authoring is refused.
    with pytest.raises(ValidationError):
        form(patch)


@pytest.mark.parametrize(
    ("mode", "value", "valid"),
    [
        ("date", "0001-01-01", True),
        ("date", "2024-02-29", True),
        ("date", "2025-02-29", False),
        ("date", "0000-01-01", False),
        ("time", "23:59:59", True),
        ("time", "24:00:00", False),
        ("time", "01:02", False),
        ("dateTime", "2026-10-24T12:00:00.123Z", True),
        ("dateTime", "2026-10-24T12:00:00+00:00", False),
        ("dateTime", "2026-10-24T12:00:00.1234Z", False),
        ("dateTime", "2026-02-30T12:00:00Z", False),
    ],
)
def test_canonical_temporal_answers(mode: str, value: str, *, valid: bool) -> None:
    # Given a configured temporal field.
    definition = form(
        {"kind": "dateTime", "dateTime": {"mode": mode, "timeZone": "America/New_York"}}
    )
    # When reviewing canonical strings, then real calendar and clock rules apply.
    assert (review_problems(definition, {"value": value}) == []) is valid


@pytest.mark.parametrize("source", ["accountId", "observerCode", "captureTime"])
def test_visible_automatic_answer_is_required_even_when_optional(source: str) -> None:
    # Given an optional automatic field, when capture context is absent, then it is required.
    patch: dict[str, JsonValue] = {"valueSource": source}
    if source == "captureTime":
        patch |= {"kind": "dateTime", "dateTime": {"mode": "dateTime", "timeZone": "UTC"}}
    definition = form(patch)
    assert [p.reason for p in review_problems(definition, {})] == ["required"]


def test_automatic_identity_uses_owner_and_immutable_envelope() -> None:
    # Given capture answers and an authenticated record owner.
    owner = UUID("00000000-0000-4000-8000-000000000001")
    definition = form({"valueSource": "accountId"})
    # When identities disagree, then the automatic field is identified.
    assert automatic_mismatches(definition, {"value": "someone else"}, owner, "QA") == ["value"]
    assert automatic_mismatches(definition, {"value": str(owner)}, owner, "QA") == []
    observer = form({"valueSource": "observerCode"})
    assert automatic_mismatches(observer, {"value": "old profile"}, owner, "QA") == ["value"]
    assert automatic_mismatches(observer, {"value": "QA"}, owner, "QA") == []


def test_historical_schema1_does_not_activate_formerly_ignored_properties() -> None:
    # Given a schema1 instrument carrying properties that its parser ignored.
    raw = canonical([question("value", "value") | {"valueSource": "accountId"}])
    raw["columnNaming"] = "questionId"
    # When historical interpretation reads it, then identity requirements remain inactive.
    definition = historical_definition(raw, 1)
    assert isinstance(definition, StoredCanonicalDefinition)
    assert definition.questions[0].value_source is None
    assert definition.column_naming is None


def test_hidden_automatic_identity_neither_requires_nor_compares_a_value() -> None:
    # Given an automatic identity question hidden behind an unanswered parent.
    hidden: dict[str, JsonValue] = {
        **question("value", "value"),
        "valueSource": "accountId",
        "dependsOn": {"kind": "answered", "question": "parent"},
    }
    raw = canonical([question("parent", "parent"), hidden])
    definition = FormDefinition.model_validate(raw)
    # When reviewing and checking the stale hidden answer, then it cannot block the record.
    assert review_problems(definition, {}) == []
    assert automatic_mismatches(definition, {"value": "stale"}, UUID(int=1), "QA") == []


def test_capture_time_is_not_compared_with_the_later_envelope_save_timestamp() -> None:
    # Given a device-authored capture instant, when identities are checked, then it is untouched.
    definition = form(
        {
            "kind": "dateTime",
            "valueSource": "captureTime",
            "dateTime": {"mode": "dateTime", "timeZone": "America/New_York"},
        }
    )
    answers: dict[str, JsonValue] = {"value": "2026-10-24T12:00:00Z"}
    assert review_problems(definition, answers) == []
    assert automatic_mismatches(definition, answers, UUID(int=1), "QA") == []


def test_decimal_definition_accepts_finite_large_bounds() -> None:
    # Given explicit decimal bounds outside safe-integer magnitude, when parsed, then retained.
    definition = form({"kind": "number", "numberMode": "decimal", "min": -1e100, "max": 1e100})
    assert review_problems(definition, {"value": 1e99}) == []


def test_decimal_answers_refuse_numbers_outside_finite_json_domain() -> None:
    # Given a decimal question, when a Python-only huge integer arrives, then it is refused.
    definition = form({"kind": "number", "numberMode": "decimal"})
    assert [p.reason for p in review_problems(definition, {"value": 10**400})] == ["range"]
