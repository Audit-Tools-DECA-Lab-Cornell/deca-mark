        "enqueue_trigger": [
          {
            "name": "enqueue_account_deletion",
            "enabled": "O",
            "definition": "CREATE TRIGGER enqueue_account_deletion AFTER INSERT OR UPDATE OF deleted_at ON fieldmaps.profiles FOR EACH ROW EXECUTE FUNCTION fieldmaps_private.enqueue_account_deletion()"
          }
        ],
        "enqueue_function": {
          "config": [
            "search_path=\"\""
          ],
          "source": "\nBEGIN\n    IF NEW.deleted_at IS NOT NULL THEN\n        INSERT INTO fieldmaps_private.account_deletions(user_id,requested_at)\n        VALUES (NEW.user_id,NEW.deleted_at) ON CONFLICT (user_id) DO NOTHING;\n    END IF;\n    RETURN NEW;\nEND;\n",
          "security_definer": true
        },
        "deletion_policies": [
          {
            "name": "backend_deletion",
            "qual": "true",
            "check": "true"
          }
        ],
        "observation_policy": {
          "name": "assigned_observations",
          "qual": "((project_id IN ( SELECT fieldmaps_private.my_project_ids() AS my_project_ids)) AND (EXISTS ( SELECT\n   FROM fieldmaps.projects p\n  WHERE ((p.id = observations.project_id) AND ((observations.created_by = fieldmaps.request_user_id()) OR ((NOT p.is_training) AND fieldmaps_private.has_project_role(p.id, ARRAY['manager'::text, 'viewer'::text])))))))"
